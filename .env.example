# ==============================================================================
# MailMind / InboxGuard Environment Configuration
# Academic Project: MailMind (Agentic AI for Smart Email and Career Intelligence)
# Application Name: InboxGuard
# ==============================================================================

# Application Environment (development, production, demo)
APP_ENV=demo
DEBUG=True
PORT=8000
SECRET_KEY=demo_super_secret_inboxguard_key_do_not_use_in_prod_change_me_32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration (gemini, openai, ollama, heuristic)
# Default 'heuristic' or 'gemini' enables reliable zero-cost local execution
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database Configuration
# Default uses local SQLite with vector cosine fallback for zero-configuration setup
# For production Docker / PostgreSQL + pgvector use:
# DATABASE_URL=postgresql+psycopg2://inboxguard:inboxguard_secret@localhost:5432/inboxguard
DATABASE_URL=sqlite:///./inboxguard.db

# Google OAuth & Gmail / Calendar API Credentials
# Leave empty to run in DEMO MODE with realistic seeded mailbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Demo Mode Settings
DEMO_MODE=true
DEMO_USER_EMAIL=alex.morgan@university.edu
DEMO_USER_NAME="Alex Morgan"

# Storage Scoring Weights (Must sum to ~1.0 for normalized penalties)
WEIGHT_STORAGE_SIZE=0.25
WEIGHT_PROMOTIONAL=0.25
WEIGHT_REDUNDANCY=0.20
WEIGHT_AGE=0.15
WEIGHT_LOW_ACTIONABILITY=0.15

# Job Match Scoring Weights
WEIGHT_REQUIRED_SKILLS=0.35
WEIGHT_PREFERRED_SKILLS=0.15
WEIGHT_SEMANTIC_SIMILARITY=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.15

# RAG & Decision Thresholds
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
DUPLICATE_SIMILARITY_THRESHOLD=0.88
WASTE_SCORE_AUTO_RECOMMEND_THRESHOLD=75
